// Grizzly 余额分销站 · 数据模型
// 账本铁律：余额只走原子条件更新，绝不先读后写。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// LDC 支付订单（买家付积分买卡密）
model Order {
  id         String    @id @default(cuid())
  outTradeNo String    @unique
  ldcTradeNo String?
  gateway    String    @default("epay") // epay | ldcpay
  name       String
  amountLdc  Decimal   @db.Decimal(18, 2)
  faceUsd    Decimal   @db.Decimal(12, 4)
  status     String    @default("pending") // pending | paid | expired | refunded | failed
  rawNotify  Json?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// purchase = 新购卡密；topup = 给已有卡密充值
  kind String @default("purchase")

  keyId String?   @unique
  key   CardKey?  @relation(fields: [keyId], references: [id])

  /**
   * 充值订单指向的目标卡密（不设 unique：同一张卡可以反复充值）。
   * 新购订单此字段为空；用 kind 区分，避免和 keyId 的 unique 约束冲突。
   */
  targetKeyId String?
  targetKey   CardKey? @relation("TopupTarget", fields: [targetKeyId], references: [id])

  @@index([status, createdAt])
  @@index([targetKeyId, status])
}

/// 卡密：面值美元，余额被站点账本"预留锁定"
model CardKey {
  id         String    @id @default(cuid())
  codeHash   String    @unique // sha256(明文)，明文只展示一次
  codePrefix String // 展示用前缀
  faceUsd    Decimal   @db.Decimal(12, 4)
  balanceUsd Decimal   @db.Decimal(12, 4)
  status     String    @default("active") // active | depleted | revoked | expired
  expiresAt  DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  order       Order?
  ledger      KeyLedger[]
  activations Activation[]

  /// 这张卡被充值过多少次（Order.targetKeyId 的反向关系）
  topups Order[] @relation("TopupTarget")

  @@index([status, createdAt])
}

/// 卡密余额流水（审计用，每笔变动一条）
model KeyLedger {
  id           String   @id @default(cuid())
  keyId        String
  deltaUsd     Decimal  @db.Decimal(12, 4) // 负=扣费，正=回补
  balanceAfter Decimal  @db.Decimal(12, 4)
  reason       String // reserve | get_number | adjust_reserve | cancel_refund | manual | expire
  refId        String?
  createdAt    DateTime @default(now())

  key CardKey @relation(fields: [keyId], references: [id])

  @@index([keyId, createdAt])
}

/// 单次接码激活记录
model Activation {
  id          String    @id @default(cuid())
  keyId       String
  grizzlyId   String    @unique
  service     String
  country     String
  phone       String
  reservedUsd Decimal   @db.Decimal(12, 4)
  costUsd     Decimal?  @db.Decimal(12, 4)
  status      String    @default("waiting") // waiting | ok | cancelled | expired
  code        String?
  smsText     String?
  lastPolledAt DateTime?
  /**
   * 取消失败后的"重试锁定到期时间"。
   *
   * 为什么要有：上游什么时候解锁取消窗口是不可预测的（实测 64s~334s 浮动，
   * 按供应商变）。买家第一次点取消若被上游拒绝，我们不能让他疯狂连点，
   * 也不能骗他说"马上就好"—— 而是锁定一小段时间，到点后提示他再试。
   * 记在服务端，刷新页面也不会丢。
   */
  cancelRetryAt DateTime?
  /** 取消尝试次数：第一次失败后用更长的重试锁。 */
  cancelAttempts Int      @default(0)
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  key CardKey @relation(fields: [keyId], references: [id])

  @@index([keyId, status])
  @@index([status, createdAt])
}

/// 池预留：已售未消耗的美元总额（"锁定"的落地凭据）
model PoolReservation {
  id        String   @id @default(cuid())
  keyId     String   @unique
  faceUsd   Decimal  @db.Decimal(12, 4)
  released  Boolean  @default(false)
  createdAt DateTime @default(now())
  releasedAt DateTime?
}

/// Grizzly 真实余额快照（对账用）
model GrizzlySnapshot {
  id               String   @id @default(cuid())
  realBalanceUsd   Decimal  @db.Decimal(14, 4)
  allocatedUsd     Decimal  @db.Decimal(14, 4)
  availableUsd     Decimal  @db.Decimal(14, 4)
  activeCount      Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

/// 对账运行记录
model ReconcileRun {
  id         String   @id @default(cuid())
  ok         Boolean
  ledgerUsd  Decimal  @db.Decimal(14, 4)
  realUsd    Decimal  @db.Decimal(14, 4)
  driftUsd   Decimal  @db.Decimal(14, 4)
  message    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// 幂等键（支付回调、外部动作）
model IdempotencyKey {
  key       String   @id
  scope     String
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
}

/// 价格缓存：上游价格接口不可用时由真实成交成本回填
model PriceCache {
  id        String   @id @default(cuid())
  service   String
  country   String
  costUsd   Decimal  @db.Decimal(12, 4)
  source    String   @default("observed") // observed | manual | api
  updatedAt DateTime @updatedAt

  @@unique([service, country])
}

/// 可热改的站点设置（优先于环境变量）。
///
/// 为什么有这张表：Vercel 上改环境变量必须重新部署，老板要的是「后台点一下就能改」。
/// 读取优先级固定为：Setting 表 > 环境变量 > 硬编码默认。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 对账基准：上游账号的「初始投入」推断值（单行表，id 固定 "singleton"）。
///
/// 为什么需要它：上游余额只有两种真实变动 —— 我们自己取号消耗、上游退款。
/// 其余变动（老板手动给 Grizzly 充值、或直接在上游买东西）系统无从得知。
/// 所以用「基准投入 − 净消耗」推算应有余额，差额即「未解释变动」，
/// 老板确认后点校准把它并进基准。
///
/// 关键：作废/恢复卡密是**纯本地动作**，不进净消耗，因此不会造成差额 ——
/// 这正是旧公式（真实 − 已售未消耗 − 历史消耗）的病灶。
model ReconcileBaseline {
  id               String   @id @default("singleton")
  /// 推断的上游初始投入（美元）= 首次观测余额 + 当时的净消耗
  baselineUsd      Decimal  @db.Decimal(14, 4)
  /// 设定基准时的净消耗（审计用）
  consumedAtSetUsd Decimal  @db.Decimal(14, 4)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
