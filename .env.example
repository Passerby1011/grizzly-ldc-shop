# 复制为 .env.local 并填入真实值。此模板只放占位符，绝不写入真实密钥。
# ===== Grizzly SMS 上游 =====
GRIZZLY_API_KEY=your_grizzly_api_key_here
GRIZZLY_API_BASE=https://api.grizzlysms.com/stubs/handler_api.php

# ===== LINUX DO Credit（易支付兼容协议）=====
LDC_PID=your_ldc_client_id
LDC_KEY=your_ldc_client_secret
LDC_API_BASE=https://credit.linux.do/epay
# 官方 ldcpay（Ed25519）可选，留空则只用易支付协议
LDC_PRIVATE_KEY_B64=

# ===== 数据与缓存 =====
DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== 站点参数 =====
ADMIN_TOKEN=change_me_to_a_long_random_string
# 1 美元 Grizzly 余额卖多少 LDC 积分（含你的毛利）
RATE_LDC_PER_USD=1.10
# 附加毛利百分比，叠加在 RATE_LDC_PER_USD 之上
MARKUP_PCT=0
# 不可被动用的安全缓冲（美元），防止账本推算与真实余额偏差导致超卖
SAFETY_BUFFER_USD=0.50
# 取号后可取消的最短等待秒数（可选，默认 90；实测 Grizzly 约 60s 内会拒绝取消）
CANCEL_LOCK_SECONDS=90
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== 对账 Cron =====
CRON_SECRET=change_me_too
